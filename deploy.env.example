APP_NAME=BikeParking
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bikeparking-dev.tail06f222.ts.net
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bike_parking
DB_USERNAME=bike_parking
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Set to true only on the development server to seed deterministic sample data.
SEED_DEVELOPMENT_DATA=false
DEVELOPMENT_SEED_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

YOLP_URL=https://map.yahooapis.jp/search/local/V1/localSearch
YOLP_GEOCODE_URL=https://map.yahooapis.jp/geocode/V1/geoCoder
YOLP_CLIENT_ID=

# Tailscale Funnel is the only public route to the application. Create a reusable
# tagged auth key in Tailscale and keep its value only in the deployment server's .env.
TS_AUTHKEY=
TS_HOSTNAME=bikeparking-dev

# Set these only after the AdSense account and both manual ad units are ready.
ADVERTISING_ENABLED=false
# Set to true only in development to render an "AD PREVIEW" placeholder without
# loading AdSense or sending third-party ad requests.
ADVERTISING_TEST_MODE=false
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME_FOOTER=
ADSENSE_SLOT_PARKING_SPOT_FOOTER=
ADSENSE_SLOT_SEARCH_FOOTER=
